{
  "name": "vehicle-catalog",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --define \"PRIMEUI_LICENSE_KEY='${PRIMEUI_LICENSE_KEY:-}'\"",
    "build": "ng build --define \"PRIMEUI_LICENSE_KEY='${PRIMEUI_LICENSE_KEY:-}'\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "oxlint --deny-warnings src",
    "format": "oxfmt --write src angular.json package.json tsconfig*.json",
    "format:check": "oxfmt --check src angular.json package.json tsconfig*.json"
  },
  "dependencies": {
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@primeicons/angular": "8.0.2",
    "@primeuix/themes": "3.0.1",
    "primeng": "22.1.2",
    "rxjs": "7.8.2",
    "tailwindcss-primeui": "0.6.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@tailwindcss/postcss": "4.3.3",
    "jsdom": "30.1.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "packageManager": "npm@11.19.0"
}
