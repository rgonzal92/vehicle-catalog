{
	admin off
	auto_https off
}

# One origin for the browser, as on the live site: the API is proxied and every other path is the
# single-page app.
:8080 {
	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Stands in for OpenAI, which no test reaches. Asked with tools to use, it asks for the lineages to
# be listed, and once it has them it answers in words. When one of the tools searches documents, it
# asks for that search instead, and then answers with a mark of the first passage. Whatever else
# it is asked, it answers with
# one thing that holds an answer to each: that Leather Seats require Premium Audio, on every trim
# and in every region, and a summary that names no feature and no trim.
#
# Asked what a text means, it answers with the same 1,536 numbers whatever the text, from
# embedding.json, in the packed form the backend's client asks for. It answers for one text, so a
# document of the browser tests is one passage long.
:8090 {
	header Content-Type application/json

	respond /v1/embeddings {file./etc/caddy/embedding.json} 200

	@hasWhatASearchReturned expression `{http.request.body}.contains('"tool_call_id"') && {http.request.body}.contains('search_documents')`
	@maySearchDocuments expression `{http.request.body}.contains('search_documents')`
	@hasWhatAToolReturned expression `{http.request.body}.contains('"tool_call_id"')`
	@mayUseTools expression `{http.request.body}.contains('"tools"')`

	route /v1/chat/completions {
		respond @hasWhatASearchReturned `{"id":"chatcmpl-a-test","object":"chat.completion","created":1,"model":"gpt-6-luna","choices":[{"index":0,"finish_reason":"stop","message":{"role":"assistant","content":"The hybrid follows in the autumn [1]."}}],"usage":{"prompt_tokens":100,"completion_tokens":20,"total_tokens":120}}` 200
		respond @maySearchDocuments `{"id":"chatcmpl-a-test","object":"chat.completion","created":1,"model":"gpt-6-luna","choices":[{"index":0,"finish_reason":"tool_calls","message":{"role":"assistant","content":null,"tool_calls":[{"id":"call_1","type":"function","function":{"name":"search_documents","arguments":"{\"query\":\"When does the hybrid follow?\"}"}}]}}],"usage":{"prompt_tokens":100,"completion_tokens":20,"total_tokens":120}}` 200
		respond @hasWhatAToolReturned `{"id":"chatcmpl-a-test","object":"chat.completion","created":1,"model":"gpt-6-luna","choices":[{"index":0,"finish_reason":"stop","message":{"role":"assistant","content":"An answer from the stand-in, from what the tool returned."}}],"usage":{"prompt_tokens":100,"completion_tokens":20,"total_tokens":120}}` 200
		respond @mayUseTools `{"id":"chatcmpl-a-test","object":"chat.completion","created":1,"model":"gpt-6-luna","choices":[{"index":0,"finish_reason":"tool_calls","message":{"role":"assistant","content":null,"tool_calls":[{"id":"call_1","type":"function","function":{"name":"list_lineages","arguments":"{}"}}]}}],"usage":{"prompt_tokens":100,"completion_tokens":20,"total_tokens":120}}` 200
		respond `{"id":"chatcmpl-a-test","object":"chat.completion","created":1,"model":"gpt-6-luna","choices":[{"index":0,"finish_reason":"stop","message":{"role":"assistant","content":"{\"saysOneRule\":true,\"kind\":\"REQUIRES\",\"source\":\"SEAT_LEATHER\",\"targets\":[\"AUDIO_PREMIUM\"],\"trims\":null,\"regions\":null,\"headline\":\"A summary from the stand-in\",\"bullets\":[\"It says what the catalog changes.\"]}"}}],"usage":{"prompt_tokens":100,"completion_tokens":20,"total_tokens":120}}` 200
	}
}
