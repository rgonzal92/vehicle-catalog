# Makes the host run the stack: Docker and Compose if they are not there yet, then the stack's
# files as the repository has them, and the stack itself with the backend image released last.
# Systems Manager runs this on the host as root, when the host first reports in and again
# whenever a line of it changes. What Terraform fills in is written the way bash writes a
# variable, so the file can be checked as bash before it is filled in.
set -euo pipefail
export AWS_DEFAULT_REGION=${region}

# The secrets Terraform keeps are at these versions: the distribution's at ${secret_version}, the
# login provider's at ${login_secret_version}. A new secret changes this line, and so has the host
# start its stack with it.

if ! command -v docker >/dev/null; then
  dnf install --assumeyes docker
fi
systemctl enable --now docker

# Compose is not among Amazon Linux's packages, so it comes from Docker's own release, and is
# used only if it is the file that release published.
plugin=/usr/local/lib/docker/cli-plugins/docker-compose
if ! echo "${compose_sha256}  $plugin" | sha256sum --check --status 2>/dev/null; then
  install -d "$(dirname "$plugin")"
  curl --fail --silent --show-error --location --output "$plugin.new" \
    "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-aarch64"
  echo "${compose_sha256}  $plugin.new" | sha256sum --check --status
  chmod 755 "$plugin.new"
  mv "$plugin.new" "$plugin"
fi

# The new files are written beside the ones in use and take their place only once Caddy accepts
# them, so a mistake in them leaves the stack running as it was.
install -d -m 700 /opt/vehicle-catalog /opt/vehicle-catalog/next
cd /opt/vehicle-catalog/next
cat > compose.yaml <<'COMPOSE_FILE'
${compose_file}
COMPOSE_FILE
cat > Caddyfile <<'CADDY_FILE'
${caddy_file}
CADDY_FILE
cat > release.sh <<'RELEASE_SCRIPT'
${release_script}
RELEASE_SCRIPT
chmod 700 release.sh
cat > settings.env <<'SETTINGS'
${settings}
SETTINGS

# Compose asks for the secrets whatever it is told to do. They play no part in checking Caddy's
# file, so there they are given as nothing in particular.
without_secrets() {
  ORIGIN_SECRET=unused DATABASE_PASSWORD=unused OIDC_CLIENT_SECRET=unused "$@"
}
without_secrets docker compose --project-name vehicle-catalog run --rm --no-deps --quiet-pull \
  caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
if cmp --silent Caddyfile ../Caddyfile; then reread=no; else reread=yes; fi
mv compose.yaml Caddyfile release.sh settings.env ..
cd ..

# The stack is started before Caddy is touched, so that whatever keeps it from starting, a secret
# that is not there among them, leaves Caddy running as it was. Caddy reads its file when it
# starts, so a new file takes a new container.
./release.sh
if [ "$reread" = yes ]; then
  docker compose up --detach --force-recreate --no-deps caddy
fi
