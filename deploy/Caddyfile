# What the host answers. Its one caller is the CloudFront distribution, which reaches it by this
# name over HTTPS and sends, in a header, a secret that nothing else knows.
{
	# No one reaches Caddy's own controls.
	admin off

	# Port 80 is open so that the certificate authority can check that the host holds its name.
	# Caddy listens there only during such a check, and sends no one on from there to HTTPS.
	auto_https disable_redirects

	servers {
		# A request that names another host than its connection was made to is turned away, so that
		# every request is either refused or answered below.
		strict_sni_host on
	}
}

{$ORIGIN_NAME} {
	# The certificate is Let's Encrypt's. Caddy gets it and renews it by itself.
	tls {
		issuer acme {
			dir {$ACME_DIRECTORY:https://acme-v02.api.letsencrypt.org/directory}

			# The authority reaches port 80 and no other, so that is where it is asked to look.
			disable_tlsalpn_challenge
		}
	}

	# A request without the distribution's secret is refused. Caddy does not start without a secret,
	# so an empty one never opens the host to everyone.
	@stranger not header X-Origin-Secret {$ORIGIN_SECRET}

	# In the order written, so that the refusal comes before every answer.
	route {
		respond @stranger 403

		# The API's requests go on to the backend, without the secret that let them in.
		reverse_proxy /api/* backend:8080 {
			header_up -X-Origin-Secret

			# A request that finds no API to connect to is kept, and the API is asked again four
			# times a second, for as long as this. That is longer than the API takes to start
			# again. One try may wait three seconds to connect, so the answer comes within 30
			# seconds, which is how long CloudFront waits for one.
			lb_try_duration 26s

			# A request that reached the API is not sent a second time, and no path is one that
			# would be. The API ended while it answered: a write may have been saved, and a read
			# may be what filled the heap.
			lb_retry_match not path *

			# Every request gets a connection of its own. A read whose connection had carried a
			# request before would be sent a second time all the same when that connection breaks,
			# by the library Caddy passes requests on with.
			transport http {
				keepalive off
			}
		}

		respond 404
	}
}
