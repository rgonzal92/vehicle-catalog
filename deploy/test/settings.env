# Stands in for the file Terraform gives the host: a login provider that is not there, and three
# demo accounts.
OIDC_CLIENT_ID=vehicle-catalog
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_COGNITO_AUTHORIZATION_URI=https://login.invalid/authorize
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_COGNITO_TOKEN_URI=https://login.invalid/token
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_COGNITO_JWK_SET_URI=https://login.invalid/jwks
LOGOUT_URL=https://login.invalid/logout
APP_DEMOACCOUNTS_0_ROLE=admin
APP_DEMOACCOUNTS_0_USERNAME=admin
APP_DEMOACCOUNTS_0_PASSWORD=a-password-everyone-knows
APP_DEMOACCOUNTS_0_SUBJECT=the-subject-of-admin
APP_DEMOACCOUNTS_0_DISPLAYNAME=Demo Admin
APP_DEMOACCOUNTS_1_ROLE=author
APP_DEMOACCOUNTS_1_USERNAME=author
APP_DEMOACCOUNTS_1_PASSWORD=a-password-everyone-knows
APP_DEMOACCOUNTS_1_SUBJECT=the-subject-of-author
APP_DEMOACCOUNTS_1_DISPLAYNAME=Demo Author
APP_DEMOACCOUNTS_2_ROLE=manager
APP_DEMOACCOUNTS_2_USERNAME=manager
APP_DEMOACCOUNTS_2_PASSWORD=a-password-everyone-knows
APP_DEMOACCOUNTS_2_SUBJECT=the-subject-of-manager
APP_DEMOACCOUNTS_2_DISPLAYNAME=Demo Manager
